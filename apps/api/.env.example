# Copy this file to .env (`cp .env.example .env`). Never commit .env.

# The local Postgres from docker-compose.yml.
DATABASE_URL="postgresql://rally:rally@localhost:5432/rally"
# Tests wipe this database, so it must be different from DATABASE_URL.
TEST_DATABASE_URL="postgresql://rally:rally@localhost:5432/rally_test"

# Same value as EXPO_PUBLIC_FIREBASE_PROJECT_ID in apps/app/.env.local.
FIREBASE_PROJECT_ID=""

PORT=3000
# Web addresses allowed to call the API, separated by commas. 8081 is the Expo dev server.
CORS_ORIGINS="http://localhost:8081"
