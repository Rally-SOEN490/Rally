# Copy this file to .env (`cp .env.example .env`). Never commit .env.

# The local Postgres from docker-compose.yml.
DATABASE_URL="postgresql://rally:rally@localhost:5432/rally"
# Tests wipe this database, so it must be different from DATABASE_URL.
TEST_DATABASE_URL="postgresql://rally:rally@localhost:5432/rally_test"

# Same value as EXPO_PUBLIC_FIREBASE_PROJECT_ID in apps/app/.env.local.
FIREBASE_PROJECT_ID=""

PORT=3000
# Web addresses allowed to call the API, separated by commas. 8081 is the Expo dev server.
CORS_ORIGINS="http://localhost:8081"

# Cloudflare R2 profile-photo storage. Leave all blank to disable uploads locally.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Organizer applications. Put your own email here to receive the review link
# when you test "Become an organizer" (several: separate them with commas).
# Empty means nobody is emailed.
ORGANIZER_REVIEWER_EMAILS=""
# The web app's address, used in the review link. 8081 is the Expo dev server.
APP_URL="http://localhost:8081"

# Email through Resend. Leave RESEND_API_KEY blank to print emails in the API's
# log instead of sending them. Without EMAIL_FROM, Resend's test sender is used,
# which only delivers to the email address of the Resend account.
RESEND_API_KEY=""
EMAIL_FROM=""
