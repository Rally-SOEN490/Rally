// AI contribution: 50% or more AI-generated

// The database tables. After editing this file, run `npm run db:migrate -- --name <what-changed>`
// to create a migration and update the generated client.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// What an account may do across Rally (see docs/architecture/roles-and-permissions.md).
// Everyone starts as a player. Captain is not stored here: it belongs to one team
// in one tournament.
enum UserRole {
  PLAYER
  ORGANIZER
  ADMIN

  @@map("user_role")
}

// A Rally account. Firebase owns the login (email and password); this row holds
// what Rally knows about the person. Field names are camelCase in TypeScript and
// snake_case in the database.
model User {
  id              String   @id @default(uuid()) @db.Uuid
  firebaseUid     String   @unique @map("firebase_uid")
  displayName     String   @map("display_name")
  // Only changed by an admin in the database, or by an approved organizer
  // application. PATCH /users/me can't change it.
  role            UserRole @default(PLAYER)
  profilePhotoKey String? @map("profile_photo_key")
  instagramUrl   String?  @map("instagram_url")
  facebookUrl    String?  @map("facebook_url")
  thoughtText    String?  @map("thought_text")
  // When the person confirmed at sign-up that they are 14 or older.
  ageConfirmedAt DateTime @map("age_confirmed_at") @db.Timestamptz
  lookingForTeam Boolean  @default(false) @map("looking_for_team")
  shownBadgeKeys String[] @default([]) @map("shown_badges")
  notificationsEnabled Boolean @default(true) @map("notifications_enabled")
  language             String  @default("EN") // "EN" or "FR"
  colorTheme           String  @default("green") @map("color_theme") // "green", "blue" or "pink"
  colorBlindMode       Boolean @default(false) @map("color_blind_mode")
  darkMode             Boolean @default(false) @map("dark_mode")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  badges         UserBadge[]
  interests      UserInterest[]
  organizerApplications OrganizerApplication[]
  organizedTournaments  Tournament[]
  teamMemberships       TeamMember[]

  @@map("users")
}

enum OrganizerApplicationStatus {
  PENDING
  APPROVED
  DENIED
  // The review link ran out before anyone decided. The person may apply again.
  EXPIRED

  @@map("organizer_application_status")
}

// A player asking to become an organizer. Reviewers get an email with a
// single-use link; the first one to approve or deny decides.
model OrganizerApplication {
  id              String                     @id @default(uuid()) @db.Uuid
  userId          String                     @map("user_id") @db.Uuid
  // The applicant's user ID while the application is pending, null afterwards.
  // Being unique, it allows one pending application per person, even when two
  // requests arrive at once.
  pendingUserId   String?                    @unique @map("pending_user_id") @db.Uuid
  description     String
  link            String?
  status          OrganizerApplicationStatus @default(PENDING)
  denyReason      String?                    @map("deny_reason")
  // SHA-256 of the token in the review link. The token itself is never stored here.
  reviewTokenHash String                     @unique @map("review_token_hash")
  expiresAt       DateTime                   @map("expires_at") @db.Timestamptz
  decidedAt       DateTime?                  @map("decided_at") @db.Timestamptz
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("organizer_applications")
}

// Emails waiting to be sent. They are saved in the same transaction as the
// change that needs them, then sent afterwards, so a crash or an email outage
// never loses one. See src/modules/email/.
model EmailOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  recipient     String
  subject       String
  // Cleared once the email is sent or given up on, so links in it don't stay here.
  body          String?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  // Set while a sender is working on the email, so two senders never send it twice.
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz
  sentAt        DateTime? @map("sent_at") @db.Timestamptz
  failedAt      DateTime? @map("failed_at") @db.Timestamptz
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([nextAttemptAt])
  @@map("email_outbox")
}

model UserInterest {
  userId    String   @map("user_id") @db.Uuid
  category  String
  key       String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category, key])
  @@index([category, key])
  @@map("user_interests")
}

model BadgeType {
  id          String      @id @default(uuid()) @db.Uuid
  key         String      @unique
  name        String
  tier        String
  description String
  imageUrl    String?     @map("image_url")
  autoAward   Boolean     @default(false) @map("auto_award")
  users       UserBadge[]
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@map("badge_types")
}

model UserBadge {
  userId      String    @map("user_id") @db.Uuid
  badgeTypeId String    @map("badge_type_id") @db.Uuid
  receivedCount Int      @default(1) @map("received_count")
  awardedAt   DateTime  @default(now()) @map("awarded_at") @db.Timestamptz
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeType   BadgeType @relation(fields: [badgeTypeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeTypeId])
  @@index([badgeTypeId])
  @@map("user_badges")
}

enum TournamentStatus {
  // Only its organizer can see it, and it can still be edited.
  DRAFT
  // Players can find it (once search reads real data, #302).
  PUBLISHED

  @@map("tournament_status")
}

enum DivisionFormat {
  TWO_V_TWO     @map("2v2")
  THREE_V_THREE @map("3v3")
  FOUR_V_FOUR   @map("4v4")
  SIX_V_SIX     @map("6v6")
  NINE_V_NINE   @map("9v9")

  @@map("division_format")
}

enum DivisionType {
  COED
  MEN
  WOMEN

  @@map("division_type")
}

enum DivisionLevel {
  C_MINUS @map("C-")
  C
  C_PLUS  @map("C+")
  B
  B_PLUS  @map("B+")
  A
  OPEN
  ELITE

  @@map("division_level")
}

// A tournament an organizer runs. It contains divisions (see
// docs/architecture/tournaments.md). A draft may be incomplete: only its name is
// required until it is published.
model Tournament {
  id                   String           @id @default(uuid()) @db.Uuid
  organizerId          String           @map("organizer_id") @db.Uuid
  status               TournamentStatus @default(DRAFT)
  name                 String
  location             String?
  courts               Int?
  // Free-form text, kept exactly as typed (line breaks, spaces, emojis).
  description          String?
  // Stored in UTC. The API reads and writes them as Montreal times.
  startsAt             DateTime?        @map("starts_at") @db.Timestamptz
  endsAt               DateTime?        @map("ends_at") @db.Timestamptz
  registrationOpensAt  DateTime?        @map("registration_opens_at") @db.Timestamptz
  registrationClosesAt DateTime?        @map("registration_closes_at") @db.Timestamptz
  publishedAt          DateTime?        @map("published_at") @db.Timestamptz
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  // Deleting the organizer's account deletes their tournaments for now.
  // That now includes the teams signed up in them: still to decide (see the open
  // points in docs/architecture/tournaments.md).
  organizer            User             @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  divisions            Division[]

  @@index([organizerId, createdAt])
  @@index([status, startsAt])
  @@map("tournaments")
}

// One competition inside a tournament, with its own format, level and teams.
model Division {
  id           String          @id @default(uuid()) @db.Uuid
  tournamentId String          @map("tournament_id") @db.Uuid
  name         String
  format       DivisionFormat
  type         DivisionType
  // One or more levels, e.g. B and B+.
  levels       DivisionLevel[]
  maxTeams     Int             @map("max_teams")
  // For display only: players pay the organizer outside Rally.
  priceCents   Int             @map("price_cents")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  tournament   Tournament      @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teams        Team[]

  @@unique([tournamentId, name])
  // Lets a team point at its division and tournament together, so the database
  // ensures a team's division belongs to the team's tournament.
  @@unique([id, tournamentId])
  @@map("divisions")
}

// A team signed up in one division of one tournament (RALLY-36). Teams last
// only for that tournament (decision #180) and have no player limit.
// See docs/architecture/teams.md.
model Team {
  id           String       @id @default(uuid()) @db.Uuid
  tournamentId String       @map("tournament_id") @db.Uuid
  divisionId   String       @map("division_id") @db.Uuid
  name         String
  // The name in lower case. Unique per tournament, so "Spikers" and "spikers"
  // can't both sign up, even when two requests arrive at once.
  nameKey      String       @map("name_key")
  // When the organizer marked the team as paid (RALLY-54). Null means unpaid.
  paidAt       DateTime?    @map("paid_at") @db.Timestamptz
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  division     Division     @relation(fields: [divisionId, tournamentId], references: [id, tournamentId], onDelete: Cascade)
  members      TeamMember[]

  @@unique([tournamentId, nameKey])
  // Lets a member row repeat the team's tournament (see TeamMember).
  @@unique([id, tournamentId])
  @@index([divisionId])
  @@map("teams")
}

// A player on a team. The tournament is copied from the team (the database
// checks it matches), so one player can be on only one team per tournament.
model TeamMember {
  teamId       String   @map("team_id") @db.Uuid
  tournamentId String   @map("tournament_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  isCaptain    Boolean  @default(false) @map("is_captain")
  joinedAt     DateTime @default(now()) @map("joined_at") @db.Timestamptz
  team         Team     @relation(fields: [teamId, tournamentId], references: [id, tournamentId], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@unique([tournamentId, userId])
  @@index([userId])
  @@map("team_members")
}
