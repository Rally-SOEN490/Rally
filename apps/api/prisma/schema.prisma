// The database tables. After editing this file, run `npm run db:migrate -- --name <what-changed>`
// to create a migration and update the generated client.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// What an account may do across Rally (see docs/architecture/roles-and-permissions.md).
// Everyone starts as a player. Captain is not stored here: it belongs to one team
// in one tournament.
enum UserRole {
  PLAYER
  ORGANIZER
  ADMIN

  @@map("user_role")
}

// A Rally account. Firebase owns the login (email and password); this row holds
// what Rally knows about the person. Field names are camelCase in TypeScript and
// snake_case in the database.
model User {
  id              String   @id @default(uuid()) @db.Uuid
  firebaseUid     String   @unique @map("firebase_uid")
  displayName     String   @map("display_name")
  // Only changed by an admin in the database, or by an approved organizer
  // application. PATCH /users/me can't change it.
  role            UserRole @default(PLAYER)
  profilePhotoKey String? @map("profile_photo_key")
  instagramUrl   String?  @map("instagram_url")
  facebookUrl    String?  @map("facebook_url")
  thoughtText    String?  @map("thought_text")
  // When the person confirmed at sign-up that they are 14 or older.
  ageConfirmedAt DateTime @map("age_confirmed_at") @db.Timestamptz
  lookingForTeam Boolean  @default(false) @map("looking_for_team")
  shownBadgeKeys String[] @default([]) @map("shown_badges")
  notificationsEnabled Boolean @default(true) @map("notifications_enabled")
  language             String  @default("EN") // "EN" or "FR"
  colorTheme           String  @default("green") @map("color_theme") // "green", "blue" or "pink"
  colorBlindMode       Boolean @default(false) @map("color_blind_mode")
  darkMode             Boolean @default(false) @map("dark_mode")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz
  badges         UserBadge[]
  interests      UserInterest[]
  organizerApplications OrganizerApplication[]

  @@map("users")
}

enum OrganizerApplicationStatus {
  PENDING
  APPROVED
  DENIED
  // The review link ran out before anyone decided. The person may apply again.
  EXPIRED

  @@map("organizer_application_status")
}

// A player asking to become an organizer. Reviewers get an email with a
// single-use link; the first one to approve or deny decides.
model OrganizerApplication {
  id              String                     @id @default(uuid()) @db.Uuid
  userId          String                     @map("user_id") @db.Uuid
  // The applicant's user ID while the application is pending, null afterwards.
  // Being unique, it allows one pending application per person, even when two
  // requests arrive at once.
  pendingUserId   String?                    @unique @map("pending_user_id") @db.Uuid
  description     String
  link            String?
  status          OrganizerApplicationStatus @default(PENDING)
  denyReason      String?                    @map("deny_reason")
  // SHA-256 of the token in the review link. The token itself is never stored here.
  reviewTokenHash String                     @unique @map("review_token_hash")
  expiresAt       DateTime                   @map("expires_at") @db.Timestamptz
  decidedAt       DateTime?                  @map("decided_at") @db.Timestamptz
  createdAt       DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  user            User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("organizer_applications")
}

// Emails waiting to be sent. They are saved in the same transaction as the
// change that needs them, then sent afterwards, so a crash or an email outage
// never loses one. See src/modules/email/.
model EmailOutbox {
  id            String    @id @default(uuid()) @db.Uuid
  recipient     String
  subject       String
  // Cleared once the email is sent or given up on, so links in it don't stay here.
  body          String?
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz
  // Set while a sender is working on the email, so two senders never send it twice.
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz
  sentAt        DateTime? @map("sent_at") @db.Timestamptz
  failedAt      DateTime? @map("failed_at") @db.Timestamptz
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([nextAttemptAt])
  @@map("email_outbox")
}

model UserInterest {
  userId    String   @map("user_id") @db.Uuid
  category  String
  key       String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category, key])
  @@index([category, key])
  @@map("user_interests")
}

model BadgeType {
  id          String      @id @default(uuid()) @db.Uuid
  key         String      @unique
  name        String
  tier        String
  description String
  imageUrl    String?     @map("image_url")
  autoAward   Boolean     @default(false) @map("auto_award")
  users       UserBadge[]
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@map("badge_types")
}

model UserBadge {
  userId      String    @map("user_id") @db.Uuid
  badgeTypeId String    @map("badge_type_id") @db.Uuid
  receivedCount Int      @default(1) @map("received_count")
  awardedAt   DateTime  @default(now()) @map("awarded_at") @db.Timestamptz
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeType   BadgeType @relation(fields: [badgeTypeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeTypeId])
  @@index([badgeTypeId])
  @@map("user_badges")
}
